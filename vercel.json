{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/compare",
      "destination": "/compare.html"
    },
    {
      "source": "/docs/api/:slug.md",
      "destination": "/docs-md/api/:slug.md"
    },
    {
      "source": "/docs/:slug.md",
      "destination": "/docs-md/:slug.md"
    },
    {
      "source": "/docs",
      "destination": "/docs-static/index.html"
    },
    {
      "source": "/docs/api",
      "destination": "/docs-static/api.html"
    },
    {
      "source": "/docs/api/:slug(add-suppression|add-thread-note|add-to-segment|ai-draft|ai-rewrite|broadcast-links|broadcast-recipients|cancel-broadcast|cancel-email|cloudflare-domain|create-api-key|create-automation|create-broadcast|create-contact|create-contact-import|create-domain|create-draft|create-inbox|create-segment|create-template|create-webhook|delete-api-key|delete-broadcast|delete-contact|delete-domain|delete-inbox|delete-segment|delete-suppression|delete-template|duplicate-automation|duplicate-broadcast|duplicate-template|edit-email-content|forward-email|get-email-content|get-usage|list-api-keys|list-attachments|list-audit-logs|list-automation-runs|list-automations|list-broadcasts|list-contact-properties|list-contacts|list-domains|list-drafts|list-emails|list-events|list-inbox-threads|list-inboxes|list-logs|list-received-attachments|list-received-emails|list-segment-contacts|list-segments|list-suppressions|list-templates|list-topics|list-webhooks|metrics|publish-automation|publish-template|remove-from-segment|replay-delivery|reply-to-thread|retrieve-automation|retrieve-broadcast|retrieve-contact|retrieve-contact-import|retrieve-domain|retrieve-email|retrieve-inbox-thread|retrieve-log|retrieve-template|run-inbox-agent|send-batch|send-broadcast|send-draft|send-email|send-event|share-email|test-webhook|update-api-key|update-broadcast|update-contact|update-domain|update-email|update-inbox|update-segment|update-template|update-thread|verify-domain|webhook-events)",
      "destination": "/docs-static/api/:slug.html"
    },
    {
      "source": "/docs/:slug(ai-writing|api-keys|audit-logs|automations|broadcasts|build-with-ai|cli|cloudflare-workers|contacts|cors|dedicated-ips|deliverability|dmarc|domain-not-verifying|domains|email-status|errors|express|getting-started|go|idempotency|inbox|limits|mcp|migrate-from-resend|nextjs|php|python|quickstart|receiving|ruby|rust|sdks|send-email|smtp|supabase|suppressions|templates|test-mode|troubleshooting|webhooks)",
      "destination": "/docs-static/:slug.html"
    },
    {
      "source": "/api/billing/:path*",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/billing/:path*"
    },
    {
      "source": "/api/events",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/automations/events"
    },
    {
      "source": "/api/automations/:path*",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/automations/:path*"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/delivrie/oauth/metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/delivrie/oauth/resource"
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/delivrie/public/openai-apps-challenge"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/delivrie/oauth/resource"
    },
    {
      "source": "/api/:path*",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/functions/v1/delivrie/:path*"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/:page(terms|privacy|dpa|acceptable-use|cookies|subprocessors|security|about|customers|careers|brand|changelog|blog|status|contact-sales|support|resend-alternative|brevo-alternative)",
      "destination": "/pages/:page.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/pages/blog/:slug.html"
    },
    {
      "source": "/media/:path*",
      "destination": "https://hnjejflinvaoxbduxeiu.supabase.co/storage/v1/object/public/email-assets/:path*"
    },
    {
      "source": "/(login|signup)",
      "destination": "/$1.html"
    },
    {
      "source": "/(inbox|automations|events|reset|confirm|verify|mfa|new-team|unsubscribe|docs|onboarding|emails|broadcasts|templates|contacts|segments|metrics|logs|domains|api-keys|webhooks|suppressions|billing|settings|profile|help|admin)",
      "destination": "/app.html"
    },
    {
      "source": "/(inbox|automations|events|docs|reset|invite|share|emails|broadcasts|templates|contacts|segments|logs|domains|webhooks|billing|settings|admin|oauth)/:rest*",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/docs-md/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/docs/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(app|login|signup).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/vs/resend",
      "destination": "/resend-alternative",
      "permanent": true
    },
    {
      "source": "/vs/brevo",
      "destination": "/brevo-alternative",
      "permanent": true
    },
    {
      "source": "/resend-vs-delivrie",
      "destination": "/resend-alternative",
      "permanent": true
    },
    {
      "source": "/blog/pricing-in-naira",
      "destination": "/pricing",
      "permanent": true
    }
  ]
}
